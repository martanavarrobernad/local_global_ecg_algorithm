# 5. TRIAL GENERATOR (same as the original)
# ==============================================================================
def generate_trials(block_type, base_side):
    side_alt = "left" if base_side == "right" else "right"
    seq_LS = {"sides": [base_side] * 5, "local_kind": "LS"}
    seq_LD = {"sides": [base_side] * 4 + [side_alt], "local_kind": "LD"}
    if block_type == 'monotone':
        item_std = {**seq_LS, "global_kind": "GS"}
        item_dev = {**seq_LD, "global_kind": "GD"}
    else:
        item_std = {**seq_LD, "global_kind": "GS"}
        item_dev = {**seq_LS, "global_kind": "GD"}

    trials = [{**item_std, "phase": "habituation"} for _ in range(HABITUATION_TRIALS)]
    n_total = random.randint(*N_TEST_RANGE)
    n_dev = int(round(n_total * GLOBAL_DEVIANT_PCT))
    pool = [{**item_std, "phase": "test"} for _ in range(n_total - n_dev)]
    pool += [{**item_dev, "phase": "test"} for _ in range(n_dev)]
    while True:   # no two consecutive global deviants
        random.shuffle(pool)
        if not any(pool[i]['global_kind'] == 'GD' and pool[i + 1]['global_kind'] == 'GD'
                   for i in range(len(pool) - 1)):
            break
    return trials + pool


