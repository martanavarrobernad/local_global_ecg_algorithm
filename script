class Experiment:
    def __init__(self, port, stream, stim_on, win, out_dir, sim=None):
        self.port, self.stream, self.stim_on, self.win = port, stream, stim_on, win
        self.out_dir, self.sim = out_dir, sim
        self.fix = visual.TextStim(win, text='+', height=0.05, color='black')
        self.instr = visual.TextStim(win, height=0.04, color='black', wrapWidth=1.2)
        self._last_esc = 0.0

    def check_escape(self, force=False):
        now = core.getTime()
        if force or now - self._last_esc > 0.05:
            self._last_esc = now
            if event.getKeys(keyList=['escape']):
                raise EscapePressed()

    def wait_until(self, t):
        # sleep while far away, busy-wait during the last 25 ms for precise timing
        while True:
            rem = t - core.getTime()
            if rem <= 0: return
            if rem > 0.025:
                time.sleep(0.001)
                self.check_escape()

    def send_trigger(self, code):
        out = code if self.stim_on else (code & 0x3F)   # OFF: remove stimulator bits 64/128
        t = core.getTime()
        self.port.setData(int(out))
        self.stream.register_sent(t, out)
        core.wait(PULSE_DURATION_S)
        self.port.setData(0)
        return t, out

    def show_text(self, msg):
        self.instr.text = msg
        self.instr.draw()
        self.win.flip()

    def wait_for_ecg(self):
        last = 0
        while self.stream.prediction() is None:
            if core.getTime() - last > 0.5:
                last = core.getTime()
                n = len(self.stream.r_times()[0])
                self.show_text(f"Waiting for ECG...\n\n{self.stream.status}\nR peaks detected: {n}\n\n[ESC] to quit")
            time.sleep(0.01)
            self.check_escape()
        _, rr, _ = self.stream.prediction()
        print(f"[ECG] Ready. HR = {60 / rr:.0f} bpm")

    def wait_for_slot(self, earliest):
        """Wait until beat 1 = predicted R - 270 ms falls after 'earliest'."""
        n_late, late_r, last_warn = 0, None, core.getTime()
        b1 = B1_BEFORE_R_MS / 1000.0
        while True:
            self.check_escape()
            now = core.getTime()
            p = self.stream.prediction()
            if p is None or now - p[0] > NO_ECG_WARN_S:
                if now - last_warn > 2.0:
                    last_warn = now
                    print(f"[ECG] *** No recent R peaks ({self.stream.status}) ***")
                time.sleep(0.002)
                continue
            last_r, rr_mean, r_pred = p
            t1 = r_pred - b1
            if t1 < earliest:            # ITI not reached yet -> wait for the next R
                time.sleep(0.002)
                continue
            if now > t1 + LATE_TOL_S:    # too late for this R -> wait for the next one
                if late_r != last_r:
                    n_late, late_r = n_late + 1, last_r
                time.sleep(0.002)
                continue
            if t1 - now > 0.025:
                time.sleep(0.001)
                continue
            return {"t1": t1, "last_r": last_r, "rr_mean": rr_mean, "r_pred": r_pred, "n_late": n_late}

    def run_block(self, run_idx, cfg, n_blocks):
        block_type, base_side = cfg['type'], cfg['side']
        print(f"\n{'=' * 60}\nBLOCK {run_idx + 1}/{n_blocks} | TACTILE | {base_side.upper()} | "
              f"{block_type.upper()} | STIM {'ON' if self.stim_on else 'OFF'}\n{'=' * 60}\n")
        trials = generate_trials(block_type, base_side)
        solution = sum(t['phase'] == 'test' and t['global_kind'] == 'GD' for t in trials)

        self.show_text("ATTENTION TASK\n\n1. Eyes on cross (+).\n2. Count 'odd' sequences.\n\n[Press SPACE to begin]")
        event.waitKeys(keyList=['space'])
        self.fix.draw()
        self.win.flip()          # static cross: no more flips during the block

        t_block = core.getTime()
        rows, aborted = [], False
        earliest, last_b5 = t_block + PRE_STIM_BUFFER, None
        try:
            for seq_i, item in enumerate(trials):
                iti_req = random.choice(ITI_VALUES) / 1000.0
                if last_b5 is not None:
                    earliest = last_b5 + iti_req
                plan = self.wait_for_slot(earliest)
                t_sent = []
                for b_i, side in enumerate(item["sides"]):
                    beat = b_i + 1
                    target = plan["t1"] + b_i * SOA_MS / 1000.0
                    self.wait_until(target)
                    code = encode_trigger(beat, side, item['local_kind'], item['global_kind'])
                    if beat in ACTIVE_BEATS:
                        ts, out = self.send_trigger(code)
                        print(f" >> TRIG: {decode_trigger_to_text(out)}")
                    else:
                        ts, out = core.getTime(), 0
                    t_sent.append(ts)
                    rows.append({
                        "block_idx": run_idx + 1, "block_type": block_type, "base_side": base_side,
                        "task_type": "tactile", "stim_on": int(self.stim_on),
                        "seq_idx": seq_i + 1, "phase": item["phase"],
                        "local_kind": item["local_kind"], "global_kind": item["global_kind"],
                        "beat": beat, "side": side, "is_active": int(beat in ACTIVE_BEATS),
                        "trigger_val": out, "trigger_desc": decode_trigger_to_text(out),
                        "onset_time": round(ts - t_block, 4),
                        "onset_planned": round(target - t_block, 4),
                        "iti_req_ms": round(iti_req * 1000) if last_b5 is not None else np.nan,
                        "iti_real_ms": round((t_sent[0] - last_b5) * 1000, 1) if last_b5 is not None else np.nan,
                        "r_last_time": round(plan["last_r"] - t_block, 4),
                        "rr_mean_ms": round(plan["rr_mean"] * 1000, 1),
                        "r_pred_time": round(plan["r_pred"] - t_block, 4),
                        "n_r_late": plan["n_late"],
                    })
                last_b5 = t_sent[-1]
            self.wait_until(core.getTime() + POST_STIM_BUFFER)
        except EscapePressed:
            aborted = True
        finally:
            self.save_block(run_idx, rows, t_block)
        print(f"\n{'#' * 50}\n   END OF BLOCK {run_idx + 1}\n{'#' * 50}\n >> TACTILE: {solution}\n{'#' * 50}\n")
        print("[RDA] " + self.stream.latency_report())
        return aborted

    def save_block(self, run_idx, rows, t_block):
        if not rows: return
        df = pd.DataFrame(rows)
        r_t, r_amp = self.stream.r_times()
        # actual (detected) R closest to each trial's predicted R
        b1 = df[df.beat == 1]
        for i, row in b1.iterrows():
            rp = row.r_pred_time + t_block
            j = int(np.argmin(np.abs(r_t - rp))) if len(r_t) else None
            if j is not None and abs(r_t[j] - rp) < 0.4:
                df.loc[df.seq_idx == row.seq_idx, "r_actual_time"] = round(r_t[j] - t_block, 4)
        if "r_actual_time" in df:
            df["beat_minus_r_actual_ms"] = ((df.onset_time - df.r_actual_time) * 1000).round(1)
            df["pred_error_ms"] = ((df.r_actual_time - df.r_pred_time) * 1000).round(1)
            e = df[df.beat == 1]
            print(f"[ECG] Beat1 - actual R: median {e.beat_minus_r_actual_ms.median():.1f} ms "
                  f"(target {-B1_BEFORE_R_MS}), |prediction error| median "
                  f"{e.pred_error_ms.abs().median():.1f} ms, p90 {e.pred_error_ms.abs().quantile(.9):.1f} ms")
        if self.sim is not None and self.sim.true_r and "r_actual_time" in df:
            tr = np.array(self.sim.true_r)
            df["r_true_time"] = [round(tr[np.argmin(np.abs(tr - (x + t_block)))] - t_block, 4)
                                 if not np.isnan(x) else np.nan for x in df.get("r_actual_time", np.nan)]
        df.to_csv(os.path.join(self.out_dir, f"block_{run_idx + 1}_tactile.csv"), index=False, sep=CSV_SEP, decimal=CSV_DECIMAL)

        # all R peaks detected during the block
        t_end = t_block + df.onset_time.max() + POST_STIM_BUFFER
        sel = (r_t >= t_block) & (r_t <= t_end)
        rdf = pd.DataFrame({"r_time": np.round(r_t[sel] - t_block, 4), "amplitude": np.round(r_amp[sel], 2)})
        rdf["rr_ms"] = (rdf.r_time.diff() * 1000).round(1)
        rdf.to_csv(os.path.join(self.out_dir, f"block_{run_idx + 1}_rpeaks.csv"), index=False, sep=CSV_SEP, decimal=CSV_DECIMAL)


def main():
    dlg = gui.Dlg(title="LOCAL-GLOBAL ECG (TEST)")
    dlg.addField("Subject ID:", "001")
    dlg.addField("Electrical stimulator:", choices=["ON", "OFF"])
    dlg.addField("ECG source:", choices=["RDA (Recorder)", "Simulation"])
    dlg.addField("Recorder IP:", RDA_HOST_DEFAULT)
    dlg.addField("ECG channel:", ECG_CHANNEL_DEFAULT)
    dlg.addField("R polarity:", choices=["auto", "positive", "negative"])
    dlg.show()
    if not dlg.OK: core.quit()
    subj_id, stim, src, host, ch, pol = [dlg.data[i] for i in range(6)]
    stim_on = (stim == "ON")
    simulate = src.startswith("Sim")

    out_dir = os.path.join(os.path.dirname(os.path.abspath(__file__)), "data_experiment", f"sub-{subj_id}", "ses-ECGtest")
    print(f"Saving data to: {out_dir}")
    os.makedirs(out_dir, exist_ok=True)

    try:
        port = parallel.ParallelPort(address=EEG_PORT_ADDRESS)
        print("Parallel Port: CONNECTED (8-BIT MODE)")
    except Exception:
        print("Parallel Port: SIMULATION MODE")

        class DummyPort:
            def setData(self, val): pass
        port = DummyPort()

    sim = None
    if simulate:
        sim = RDASimServer()
        sim.start()
        host, rda_port, ch = "127.0.0.1", SIM_PORT, "ECG"
        real_port = port

        class SimPort:
            def setData(self, val):
                real_port.setData(val)
                if val: sim.add_marker(val)
        port = SimPort()
    else:
        rda_port = RDA_PORT

    stream = ECGStream(host, rda_port, ch, pol)
    stream.start()

    win = visual.Window(screen=1, size=[1920, 1080], fullscr=True, monitor='testMonitor',
                        color=BG_COLOR, units='height', allowGUI=False, winType='pyglet')
    exp = Experiment(port, stream, stim_on, win, out_dir, sim)

    configs = [("monotone", "right"), ("monotone", "left"), ("discordant", "right"), ("discordant", "left")]
    random.shuffle(configs)
    plan = [{"type": t, "side": s} for t, s in configs]

    try:
        for i, cfg in enumerate(plan):
            exp.wait_for_ecg()
            if exp.run_block(i, cfg, len(plan)):
                print("ESCAPE: experiment interrupted (block data saved)")
                break
            if i < len(plan) - 1:
                exp.show_text("BREAK\n\nRelax for a moment.\n\n[SPACE] to continue")
                event.waitKeys(keyList=['space'])
    except EscapePressed:
        print("ESCAPE: experiment interrupted")
    finally:
        if stream.marker_log:
            pd.DataFrame(stream.marker_log).to_csv(os.path.join(out_dir, "rda_markers.csv"), index=False, sep=CSV_SEP, decimal=CSV_DECIMAL)
        stream.stop()
        win.close()


if __name__ == "__main__":
    main()
