class SampleClock:
    """Converts sample index -> PC clock (core.getTime)."""

    def __init__(self, dt):
        self.dt = dt
        self.cands = deque(maxlen=ANCHOR_WINDOW_BLOCKS)
        self.marker_offsets = deque(maxlen=20)
        self.delays = deque(maxlen=3000)

    def on_block(self, n_end, t_arr):
        self.cands.append(t_arr - n_end * self.dt)
        self.delays.append(t_arr - (self.t0 + n_end * self.dt))

    @property
    def t0(self):
        return min(self.cands)

    @property
    def correction(self):
        return float(np.median(self.marker_offsets)) if self.marker_offsets else 0.0

    def to_time(self, idx, corrected=True):
        return self.t0 + idx * self.dt + (self.correction if corrected else 0.0)


class RPeakDetector:
    def __init__(self, fs, polarity="auto"):
        self.fs = fs
        self.sos = butter(2, [BP_LOW_HZ, BP_HIGH_HZ], btype="bandpass", fs=fs, output="sos")
        self.zi = None
        self.raw = np.empty(0)
        self.d = np.empty(0)
        self.base = 0
        self.n = 0
        self.polarity = {"positive": 1, "negative": -1}.get(polarity)
        self.calibrated = False
        self.amp_hist = deque(maxlen=8)
        self.thr = np.inf
        self.scan = 0
        self.cross = None
        self.last_r = -10 ** 9
        self.last_lower = 0
        self.r_idx = []
        self.r_amp = []

    def add(self, x):
        x = np.asarray(x, dtype=float)
        if self.zi is None:
            self.zi = sosfilt_zi(self.sos) * x[0]
        y, self.zi = sosfilt(self.sos, x, zi=self.zi)
        self.raw = np.concatenate([self.raw, x])
        self.d = np.concatenate([self.d, np.abs(y)])
        self.n += len(x)
        keep = int(12 * self.fs)
        if len(self.raw) > keep:
            cut = len(self.raw) - keep
            self.raw = self.raw[cut:]
            self.d = self.d[cut:]
            self.base += cut
        if not self.calibrated:
            if self.n >= CALIB_S * self.fs:
                self._calibrate()
            return
        self._scan()
        # if no R for LOST_S seconds, halve the threshold (at most once every LOST_S)
        if self.cross is None and self.n - max(self.last_r, self.last_lower) > LOST_S * self.fs:
            self.thr *= 0.5
            self.amp_hist.clear()
            self.amp_hist.append(self.thr / THRESH_FRAC)
            self.last_lower = self.n
            self.scan = self.n - int(LOST_S * self.fs)
            print("[ECG] No R detected: lowering threshold")
            self._scan()

    def _calibrate(self):
        start = self.base + int(0.5 * self.fs)
        d = self.d[start - self.base:]
        amp0 = np.percentile(d, 99.5)
        self.thr = THRESH_FRAC * amp0
        self.amp_hist.append(amp0)
        if self.polarity is None:
            wb, wa = int(WIN_BEFORE_S * self.fs), int(WIN_AFTER_S * self.fs)
            refr = int(REFRACTORY_S * self.fs)
            pos = neg = 0.0
            i = start
            while True:
                hits = np.nonzero(self.d[i - self.base:] > self.thr)[0]
                if len(hits) == 0: break
                c = i + hits[0]
                if c + wa > self.n: break
                w = self.raw[max(c - wb, self.base) - self.base:c + wa - self.base]
                med = np.median(w)
                pos += w.max() - med
                neg += med - w.min()
                i = c + refr
            self.polarity = 1 if pos >= neg else -1
        self.scan = start
        self.calibrated = True
        print(f"[ECG] Calibrated: polarity {'+' if self.polarity > 0 else '-'}, threshold {self.thr:.1f}")
        self._scan()

    def _scan(self):
        refr = int(REFRACTORY_S * self.fs)
        wb, wa = int(WIN_BEFORE_S * self.fs), int(WIN_AFTER_S * self.fs)
        while True:
            if self.cross is None:
                start = max(self.scan, self.last_r + refr, self.base)
                if start >= self.n: break
                hits = np.nonzero(self.d[start - self.base:] > self.thr)[0]
                if len(hits) == 0:
                    self.scan = self.n
                    break
                self.cross = start + hits[0]
            if self.n < self.cross + wa: break
            lo = max(self.cross - wb, self.base)
            hi = self.cross + wa
            w = self.raw[lo - self.base:hi - self.base]
            r = lo + int(np.argmax(self.polarity * (w - np.median(w))))
            amp = float(self.d[lo - self.base:hi - self.base].max())
            self.amp_hist.append(amp)
            self.thr = THRESH_FRAC * float(np.median(self.amp_hist))
            self.r_idx.append(r)
            self.r_amp.append(amp)
            self.last_r = r
            self.scan = hi
            self.cross = None


class ECGStream(threading.Thread):
    """Background RDA client: reads the ECG channel and detects R peaks."""

    def __init__(self, host, port, channel, polarity):
        super().__init__(daemon=True)
        self.host, self.port, self.channel, self.polarity = host, port, channel, polarity
        self.lock = threading.Lock()
        self.running = True
        self.sock = None
        self.det = None
        self.clock = None
        self.sent = deque(maxlen=60)       # [t_sent, code, matched]
        self.marker_log = []
        self.status = "connecting"
        self.n_overflows = 0

    # --- RDA protocol ---
    def _recv(self, n):
        buf = bytearray()
        while len(buf) < n:
            chunk = self.sock.recv(n - len(buf))
            if not chunk:
                raise ConnectionError("RDA connection closed")
            buf += chunk
        return buf

    @staticmethod
    def _split(raw):
        return [s.decode("latin-1") for s in bytes(raw).split(b"\x00")[:-1]]

    def run(self):
        while self.running:
            try:
                self.sock = socket.create_connection((self.host, self.port), timeout=3)
                self.sock.settimeout(None)
                print(f"[RDA] Connected to {self.host}:{self.port}")
                self.status = "connected, waiting for data"
                self._loop()
            except Exception as e:
                if not self.running: break
                self.status = f"not connected ({e})"
                print(f"[RDA] {self.status}. Retrying in 2 s...")
                time.sleep(2)

    def _loop(self):
        nch = ecg_i = None
        res = 1.0
        n_samples = 0
        last_block = -1
        while self.running:
            hdr = self._recv(24)
            _, _, _, _, msgsize, msgtype = struct.unpack("<llllLL", hdr)
            raw = self._recv(msgsize - 24)
            t_arr = core.getTime()
            if msgtype == 1:
                nch, sint = struct.unpack("<Ld", raw[:12])
                resolutions = struct.unpack(f"<{nch}d", raw[12:12 + 8 * nch])
                names = self._split(raw[12 + 8 * nch:])
                low = [n.lower() for n in names]
                if self.channel.lower() not in low:
                    self.status = f"channel '{self.channel}' not found. Channels: {names}"
                    print(f"[RDA] ERROR: {self.status}")
                    raise ConnectionError(self.status)
                ecg_i = low.index(self.channel.lower())
                res = resolutions[ecg_i]
                fs = 1e6 / sint
                with self.lock:
                    self.det = RPeakDetector(fs, self.polarity)
                    self.clock = SampleClock(1.0 / fs)
                n_samples, last_block = 0, -1
                self.status = "receiving"
                print(f"[RDA] Start: {nch} channels, fs = {fs:.0f} Hz, ECG = '{names[ecg_i]}'")
            elif msgtype == 4 and nch is not None:
                block, points, n_mk = struct.unpack("<LLL", raw[:12])
                if last_block != -1 and block > last_block + 1:
                    missed = (block - last_block - 1) * points
                    self.n_overflows += 1
                    print(f"[RDA] *** Overflow: {block - last_block - 1} blocks lost ***")
                    with self.lock:
                        self.det.add(np.full(missed, self.det.raw[-1] if len(self.det.raw) else 0.0))
                    n_samples += missed
                last_block = block
                data = np.frombuffer(bytes(raw[12:12 + 4 * points * nch]), dtype="<f4")
                ecg = data.reshape(points, nch)[:, ecg_i].astype(float) * res
                block_start = n_samples
                n_samples += points
                with self.lock:
                    self.clock.on_block(n_samples, t_arr)
                    self.det.add(ecg)
                idx = 12 + 4 * points * nch
                for _ in range(n_mk):
                    msize = struct.unpack("<L", raw[idx:idx + 4])[0]
                    pos, _pts, _ch = struct.unpack("<LLl", raw[idx + 4:idx + 16])
                    td = self._split(raw[idx + 16:idx + msize]) + ["", ""]
                    self._on_marker(block_start + pos, td[0], td[1])
                    idx += msize
            elif msgtype == 3:
                self.status = "Recorder stopped"
                print("[RDA] Stop received")

    def _on_marker(self, abs_pos, mtype, desc):
        with self.lock:
            est = self.clock.to_time(abs_pos, corrected=False)
            m = re.search(r"(\d+)", desc)
            code = int(m.group(1)) if m else None
            best = None
            for s in self.sent:
                if s[2]: continue
                dtm = s[0] - est
                if abs(dtm) > 0.15: continue
                if code is not None and code != s[1] and abs(dtm) > 0.05: continue
                if best is None or abs(dtm) < abs(best[0] - est): best = s
            offset = None
            if best is not None and code is not None:
                best[2] = True
                offset = best[0] - est
                self.clock.marker_offsets.append(offset)
            self.marker_log.append({"t_pc_est": est, "type": mtype, "desc": desc,
                                    "matched_t_sent": best[0] if best else np.nan,
                                    "offset_ms": offset * 1000 if offset is not None else np.nan})

    # --- interface for the experiment ---
    def register_sent(self, t, code):
        with self.lock:
            self.sent.append([t, code, False])

    def prediction(self):
        """(last R, mean RR, predicted R) on the PC clock, or None if there are not 8 valid RR."""
        with self.lock:
            if self.det is None or not self.det.calibrated or len(self.det.r_idx) < 2:
                return None
            idx = np.array(self.det.r_idx[-(N_RR_MEAN * 2 + 1):])
            t = self.clock.to_time(idx)
        rr = np.diff(t)
        rr = rr[(rr >= RR_MIN_S) & (rr <= RR_MAX_S)]
        if len(rr) < N_RR_MEAN:
            return None
        rr_mean = float(rr[-N_RR_MEAN:].mean())
        return t[-1], rr_mean, t[-1] + rr_mean

    def r_times(self):
        with self.lock:
            if self.det is None: return np.array([]), np.array([])
            return self.clock.to_time(np.array(self.det.r_idx, dtype=float)), np.array(self.det.r_amp)

    def latency_report(self):
        with self.lock:
            if self.clock is None or not self.clock.delays: return "no data"
            d = np.array(self.clock.delays) * 1000
            corr = self.clock.correction * 1000
            nm = len(self.clock.marker_offsets)
        return (f"RDA arrival jitter: median {np.median(d):.1f} ms, p95 {np.percentile(d, 95):.1f} ms | "
                f"marker-based correction: {corr:+.1f} ms ({nm} markers) | overflows: {self.n_overflows}")

    def stop(self):
        self.running = False
        try: self.sock.close()
        except Exception: pass


