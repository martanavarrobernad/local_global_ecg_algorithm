# 2. TRIGGERS (8 BITS)
# ==============================================================================
def encode_trigger(beat, side, local_kind, global_kind, is_visual_task=False):
    """
    [Bit 7]: Right Stim (128) -> Pin 9
    [Bit 6]: Left Stim  (64)  -> Pin 8
    [Bit 5]: Task Type  (32)  -> Pin 7
    [Bit 4]: Global Dev (16)  -> Pin 6
    [Bit 3]: Local Dev  (8)   -> Pin 5
    [Bit 0-2]: Beat (1-7)     -> Pin 2,3,4
    """
    trigger = beat & 0b111
    if local_kind == 'LD': trigger |= 8
    if global_kind == 'GD': trigger |= 16
    if is_visual_task: trigger |= 32
    if side == "left": trigger |= 64
    elif side == "right": trigger |= 128
    return trigger


def decode_trigger_to_text(trig):
    if trig == 0: return "No Trigger"
    side = "RIGHT" if (trig & 128) else ("LEFT" if (trig & 64) else "NONE")
    task = "VIS" if (trig & 32) else "TAC"
    glob = "GlobDEV" if (trig & 16) else "GlobSTD"
    loc = "LocDEV" if (trig & 8) else "LocSTD"
    return f"[{task}] {side} | {loc}-{glob} | Beat {trig & 7} (Code: {trig})"


