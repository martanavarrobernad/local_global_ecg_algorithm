# 4. RDA SIMULATOR ("Simulation" mode only)
# ==============================================================================
class RDASimServer(threading.Thread):
    """Local RDA server with a synthetic ECG. Sent triggers come back as markers."""

    def __init__(self, port=SIM_PORT, fs=5000, block_s=0.02, hr_bpm=72, polarity=1):
        super().__init__(daemon=True)
        self.port, self.fs, self.dt, self.block_s = port, fs, 1.0 / fs, block_s
        self.rr0, self.pol = 60.0 / hr_bpm, polarity
        self.names = ["Fz", "Cz", "ECG"]
        self.pending = []
        self.lock = threading.Lock()
        self.true_r = []           # true R times on the PC clock
        self.beats = [0.5]
        self.running = True
        self.srv = socket.socket()
        self.srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        self.srv.bind(("127.0.0.1", port))
        self.srv.listen(1)

    def add_marker(self, code):
        with self.lock:
            pos = int(round((core.getTime() - self.t_start) / self.dt))
            self.pending.append((pos, code))

    def _ecg(self, n0, n1):
        t = np.arange(n0, n1) * self.dt
        while self.beats[-1] < t[-1] + 2:
            k = len(self.beats)
            self.beats.append(self.beats[-1] + self.rr0 * (1 + 0.06 * np.sin(2 * np.pi * k / 12))
                              + random.gauss(0, 0.02))
        y = 100 * np.sin(2 * np.pi * 0.3 * t) + 30 * np.sin(2 * np.pi * 50 * t) + np.random.randn(len(t)) * 20
        comps = [(-0.16, 150, 0.025), (-0.025, -100, 0.008), (0, 1000, 0.010),
                 (0.025, -250, 0.008), (0.25, 300, 0.040)]   # P, Q, R, S, T waves
        for b in self.beats:
            if t[0] - 0.5 < b < t[-1] + 0.5:
                for off, a, w in comps:
                    y += self.pol * a * np.exp(-0.5 * ((t - b - off) / w) ** 2)
        return y

    @staticmethod
    def _msg(mtype, payload):
        return struct.pack("<llllLL", 1, 2, 3, 4, 24 + len(payload), mtype) + payload

    def run(self):
        conn, _ = self.srv.accept()
        nch = len(self.names)
        payload = struct.pack("<Ld", nch, self.dt * 1e6) + struct.pack(f"<{nch}d", *([0.1] * nch))
        payload += b"".join(n.encode() + b"\x00" for n in self.names)
        conn.sendall(self._msg(1, payload))
        self.t_start = core.getTime()
        n_sent, block = 0, 0
        while self.running:
            time.sleep(self.block_s)
            n_now = int((core.getTime() - self.t_start) / self.dt)
            if n_now <= n_sent: continue
            ecg = self._ecg(n_sent, n_now)
            data = np.random.randn(n_now - n_sent, nch) * 10
            data[:, 2] = ecg
            data = (data / 0.1).astype("<f4")
            with self.lock:
                mk = [(p, c) for p, c in self.pending if p < n_now]
                self.pending = [(p, c) for p, c in self.pending if p >= n_now]
            mbytes = b""
            for p, c in mk:
                s = b"Stimulus\x00" + f"S{c:3d}".encode() + b"\x00"
                mbytes += struct.pack("<LLLl", 16 + len(s), max(p - n_sent, 0), 1, -1) + s
            payload = struct.pack("<LLL", block, n_now - n_sent, len(mk)) + data.tobytes() + mbytes
            time.sleep(random.uniform(0.003, 0.025))      # simulated network latency
            try:
                conn.sendall(self._msg(4, payload))
            except OSError:
                break
            self.true_r = [self.t_start + b for b in self.beats if b < n_now * self.dt]
            n_sent, block = n_now, block + 1


